{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjo163/moonframe/blob/main/schemas/moonframe-token-subset.schema.json",
  "title": "Proposed Moonframe bounded DTCG 2025.10 token tree — SPEC FIXTURES ONLY",
  "description": "Structural candidate. Not a declaration of full DTCG conformance or installed parser. Production token source does not exist; whole-alias/type/overlay semantics require separate checks.",
  "$ref": "#/$defs/group",
  "$defs": {
    "reference": {
      "type": "string",
      "pattern": "^\\{[a-zA-Z0-9_-]+(?:\\.[a-zA-Z0-9_-]+)*\\}$"
    },
    "colorValue": {
      "type": "object",
      "required": [
        "colorSpace",
        "components"
      ],
      "properties": {
        "colorSpace": {
          "const": "srgb"
        },
        "components": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          ],
          "minItems": 3,
          "maxItems": 3
        },
        "alpha": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "dimValue": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "px",
            "rem"
          ]
        }
      },
      "additionalProperties": false
    },
    "timeValue": {
      "type": "object",
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "const": "ms"
        }
      },
      "additionalProperties": false
    },
    "extensions": {
      "type": "object",
      "properties": {
        "moonframe": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "token": {
      "type": "object",
      "required": [
        "$type",
        "$value"
      ],
      "properties": {
        "$type": {
          "enum": [
            "color",
            "dimension",
            "duration",
            "number",
            "fontFamily",
            "fontWeight",
            "cubicBezier"
          ]
        },
        "$value": {},
        "$description": {
          "type": "string"
        },
        "$deprecated": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        },
        "$extensions": {
          "$ref": "#/$defs/extensions"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "$type": {
                "const": "color"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/colorValue"
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "dimension"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/dimValue"
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "duration"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/timeValue"
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "number"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "fontFamily"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "fontWeight"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "$type": {
                "const": "cubicBezier"
              }
            },
            "required": [
              "$type"
            ]
          },
          "then": {
            "properties": {
              "$value": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 4,
                    "maxItems": 4
                  },
                  {
                    "$ref": "#/$defs/reference"
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(\\$description|\\$extensions|\\$deprecated|[a-zA-Z0-9_-]+)$"
      },
      "properties": {
        "$description": {
          "type": "string"
        },
        "$extensions": {
          "$ref": "#/$defs/extensions"
        },
        "$deprecated": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "patternProperties": {
        "^[a-zA-Z0-9_-]+$": {
          "oneOf": [
            {
              "$ref": "#/$defs/group"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bjo163/moonframe/blob/main/schemas/moonframe-accessibility-qa-record.schema.json",
  "title": "Moonframe accessibility/visual QA observation or exception record — Draft 2020-12 (proposed)",
  "description": "Evidence structural contract only, no production browser/AT test results. Full generic JSON Schema evaluation is not installed. Canonical WCAG IDs and component/skin references checked in Node contract validator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "kind",
    "status",
    "criterionRef",
    "scope",
    "evidence",
    "review",
    "exception"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "recordId": {
      "type": "string",
      "pattern": "^avqa\\.[a-z][a-z0-9-]+$"
    },
    "kind": {
      "enum": [
        "observation",
        "exception",
        "defect"
      ]
    },
    "status": {
      "enum": [
        "not-assessed",
        "specified",
        "automated-check-passed",
        "manual-review-passed",
        "assistive-tech-reviewed",
        "known-issue",
        "waived-with-rationale",
        "verified-for-release-scope"
      ]
    },
    "criterionRef": {
      "type": "string",
      "pattern": "^wcag-[0-9]\\.[0-9]\\.[0-9]+$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "skinId",
        "mode",
        "specimenId",
        "viewport",
        "state",
        "consumer"
      ],
      "properties": {
        "componentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "skinId": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "enum": [
            "light",
            "dark",
            null
          ]
        },
        "specimenId": {
          "type": [
            "string",
            "null"
          ]
        },
        "viewport": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": [
            "string",
            "null"
          ]
        },
        "consumer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitSHA",
        "testRunUrl",
        "capturePath",
        "baselineHash",
        "manualNotes",
        "atLog",
        "environment"
      ],
      "properties": {
        "commitSHA": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{40}$"
        },
        "testRunUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "capturePath": {
          "type": [
            "string",
            "null"
          ]
        },
        "baselineHash": {
          "type": [
            "string",
            "null"
          ]
        },
        "manualNotes": {
          "type": [
            "string",
            "null"
          ]
        },
        "atLog": {
          "type": [
            "string",
            "null"
          ]
        },
        "environment": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewedAt",
        "verdict"
      ],
      "properties": {
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "verdict": {
          "enum": [
            "pass",
            "fail",
            "needs-review",
            null
          ]
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issueUrl",
        "owner",
        "rationale",
        "userImpact",
        "mitigation",
        "expiry",
        "approvedBy",
        "scopeBoundary"
      ],
      "properties": {
        "issueUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "userImpact": {
          "type": [
            "string",
            "null"
          ]
        },
        "mitigation": {
          "type": [
            "string",
            "null"
          ]
        },
        "expiry": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "approvedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "scopeBoundary": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not-assessed",
              "specified"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "commitSHA": {
                "type": "null"
              },
              "testRunUrl": {
                "type": "null"
              },
              "capturePath": {
                "type": "null"
              },
              "baselineHash": {
                "type": "null"
              },
              "manualNotes": {
                "type": "null"
              },
              "atLog": {
                "type": "null"
              },
              "environment": {
                "type": "null"
              }
            }
          },
          "review": {
            "properties": {
              "reviewer": {
                "type": "null"
              },
              "reviewedAt": {
                "type": "null"
              },
              "verdict": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "automated-check-passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "commitSHA": {
                "type": "string"
              },
              "testRunUrl": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "object"
              }
            },
            "required": [
              "commitSHA",
              "testRunUrl",
              "environment"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "manual-review-passed",
              "assistive-tech-reviewed",
              "verified-for-release-scope"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "reviewer": {
                "type": "string",
                "minLength": 1
              },
              "reviewedAt": {
                "type": "string"
              },
              "verdict": {
                "const": "pass"
              }
            }
          },
          "evidence": {
            "properties": {
              "commitSHA": {
                "type": "string"
              },
              "manualNotes": {
                "type": "string",
                "minLength": 1
              },
              "environment": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "assistive-tech-reviewed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "atLog": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "waived-with-rationale"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "exception"
          },
          "exception": {
            "properties": {
              "issueUrl": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "userImpact": {
                "type": "string",
                "minLength": 1
              },
              "mitigation": {
                "type": "string",
                "minLength": 1
              },
              "expiry": {
                "type": "string"
              },
              "approvedBy": {
                "type": "string",
                "minLength": 1
              },
              "scopeBoundary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified-for-release-scope"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "testRunUrl": {
                "type": "string",
                "minLength": 1
              },
              "atLog": {
                "type": "string",
                "minLength": 1
              },
              "capturePath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}

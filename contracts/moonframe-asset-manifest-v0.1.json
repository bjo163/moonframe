    "proposed",
    "rights-pending",
    "design-review",
    "approved",
    "rejected",
    "deprecated"
  ],
  "securityRules": [
    "No untrusted inline SVG or event handlers/scripts/external references",
    "Optimize and sanitize SVG with explicit allowlist",
    "Treat remote media as untrusted; do not inject HTML",
    "Decorative files do not encode exclusive business meaning",
    "Verify font/icon/illustration licenses; AI-generated is not automatic rights clearance"
  ],
  "reviewRequirements": [
    "human uniqueness review",
    "license evidence",
    "light/dark/fallback",
    "dimensions/viewBox checks",
    "accessibility alt or decorative-hidden",
    "checksum",
    "source/export parity"
  ],
  "examplesAreNotProduced": true,
  "brandAuthority": "docs/brand/original-asset-brand-bible.md",
  "designBriefRef": "moonframe-skin-asset-briefs-v0.1.json",

  "brandHierarchy": {
    "status": "proposed-pending-owner-approval",
    "model": "one-umbrella-brand-with-15-visual-editions",
    "coreBrandMarkStatus": "not-produced",
    "coreWordmarkStatus": "not-produced",
    "independentLegalBrands": false,
    "skinBadgePolicy": "optional-by-reviewed-need; not always a different logo",
    "hostBrand": "consumer-app-owns-logo-and-favicon"
  },
  "categoriesAreCandidatePoolNotRequiredPerSkin": true,
  "categoriesClarification": "Historical plannedPerSkin.categories lists candidate categories NOT ten mandatory produced asset families. No standalone skin logo obligation. Approved minimum scoped by documented skin brief.",
  "approvedAssets": [],
  "assetRegistryPolicy": {
    "status": "planned-no-assets",
    "namespaceProposed": "mf.brand.*, mf.skin.<canonicalSkinId>.*, mf.icon.*, mf.illustration.*, mf.font.*, mf.sound.optional.*",
    "filePathSemantics": "logical ID stable; generated paths versioned/content-hashed and never source of truth",
    "distributableRequirements": [
      "accepted status backed by reviewer/time",
      "rights/provenance cleared and license text evidence",
      "real source and exports exist and path safe",
      "SHA-256 source/output recorded",
      "SVG vetted safe content and markup",
      "accessible context-tested variant or fallback",
      "distribution rights for package clear"
    ],
    "prohibited": [
      "claim produced from empty array",
      "publish unreviewed generated artwork",
      "copy unlabeled online asset",
      "ship source without license",
      "infinite SVG references",
      "unsafe inline SVG",
      "font without RFN/redistribution check"
    ],
    "fallback": "missing decorative asset renders without decoration; missing functional asset blocks release"
  },
  "approvalWorkflow": {
    "stages": [
      "requested",
      "brief-approved",
      "source-created",
      "provenance-reviewed",
      "license-cleared",
      "accessibility-reviewed",
      "optimized",
      "visual-reviewed",
      "accepted",
      "published",
      "deprecated"
    ],
    "holds": [
      "quarantined",
      "rejected"
    ],
    "currentStage": "requested",
    "approvalsCompleted": [],
    "evidenceCount": 0
  },
  "licenseGovernance": {
    "repoCodeLicense": "not-selected-no-LICENSE-present",
    "brandTrademarkStatus": "not-reviewed",
    "brandMarkLicense": "not-selected",
    "fontsLicense": "per-file-not-selected",

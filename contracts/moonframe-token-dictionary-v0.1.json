{
  "contractVersion": "0.1.0",
  "contractId": "MF-TOKEN-001",
  "status": "dictionary-contract-only-no-final-token-values",
  "purpose": "Defines token namespaces, semantic roles, metadata and validation. Does not pretend that final values for all 30 appearances are approved.",
  "principles": [
    "Components consume semantic tokens, not literal palette values.",
    "Primitive/reference tokens may feed semantic aliases; consumers should not bind directly to primitives.",
    "Every required semantic token resolves in every Light/Dark map.",
    "Token aliases cannot cycle and every reference must resolve.",
    "Skin-specific decorative tokens are not substitutes for semantic interaction/status tokens.",
    "DTCG-compatible source format is preferred where supported by the chosen toolchain."
  ],
  "naming": {
    "separator": ".",
    "stableLowerCase": true,
    "avoidProductSpecificDomainTerms": true,
    "examples": [
      "color.surface.canvas",
      "color.text.primary",
      "color.action.primary",
      "color.status.danger",
      "type.size.body",
      "space.4",
      "radius.control",
      "motion.duration.fast",
      "layer.dialog"
    ],
    "forbiddenPatterns": [
      "raw hex embedded in component CSS",
      "cyclic aliases",
      "skin id inside semantic token meaning",
      "duplicate tokens with different names and identical meaning without reason"
    ]
  },
  "families": [
    {
      "id": "color.primitive",
      "purpose": "Raw palette/reference values by skin; never the default component API",
      "required": true
    },
    {
      "id": "color.semantic",
      "purpose": "Canvas, surfaces, text, actions, borders, focus, selection, overlay, status, chart and code colors",
      "required": true
    },
    {
      "id": "type.family",
      "purpose": "Body, heading, display, mono and data font roles with licensing metadata",
      "required": true
    },
    {
      "id": "type.scale",
      "purpose": "Font-size, weight, line-height, tracking and paragraph measure",
      "required": true
    },
    {
      "id": "space",
      "purpose": "Named spacing scale for gap, padding and section rhythm",
      "required": true
    },
    {
      "id": "size",
      "purpose": "Control, icon, avatar, touch target and row dimensions",
      "required": true
    },
    {
      "id": "geometry",
      "purpose": "Radius, border width/style, outline width/offset and divider thickness",
      "required": true
    },
    {
      "id": "elevation",
      "purpose": "Shadow and surface layering",
      "required": true
    },
    {
      "id": "material",
      "purpose": "Optional grain, halftone, glow, blur and texture budgets",
      "required": true
    },
    {
      "id": "motion",
      "purpose": "Duration, easing, distance, stagger and enter/exit recipe",
      "required": true
    },
    {
      "id": "layer",
      "purpose": "Documented z-index scale for sticky/menu/popover/dialog/toast/tooltip",
      "required": true
    },
    {
      "id": "density",
      "purpose": "Compact/comfortable/spacious aliases and metrics",
      "required": true
    },
    {
      "id": "component",
      "purpose": "Approved exception tokens for specific components",
      "required": false
    },
    {
      "id": "asset",
      "purpose": "Stable asset IDs and references; no binary payloads",
      "required": true
    }
  ],

      "moonquest",
      "moonledger"
    ],
    "everyRequiredSemanticTokenInEveryAppearance": true,
    "noUnresolvedReferences": true,
    "noReferenceCycles": true,
    "fontLicenseAndFallbacksDocumented": true,
    "contrastReviewedByRole": true
  },
  "validation": {
    "failOnMissingRequiredToken": true,
    "failOnUnexpectedTokenType": true,
    "failOnUnresolvedReference": true,
    "failOnCycle": true,
    "failOnMissingModeMap": true,
    "reportRawValuesInComponentSource": true,
    "visualReviewStillRequired": true
  },
  "generationTargets": [
    "CSS custom properties",
    "Tailwind CSS v4 integration layer",
    "TypeScript token types/helpers",
    "Skin Lab reference export"
  ],
  "implementationNote": "Names are the proposed contract. Final token values, exact DTCG structure and generator choices must be approved after repository/toolchain audit.",
  "revisionDate": "2026-10-25",
  "dictionaryRole": "authoritative required-token vocabulary and taxonomy; NOT canonical production values",
  "canonicalValueSource": null,
  "futureTokenSourcePlan": "moonframe-token-source-plan-v0.1.json",
  "catalogClarification": "Mixed required token-name inventory: primitive, semantic, density and layering names. The historical field requiredSemanticTokenExamples is kept for compatibility; it is NOT all semantic values.",
  "namingPolicy": {
    "newIds": "lowercase-dotted-kebab-segments only (e.g. type.line-height.normal). Keep existing 78 tokens stable; no silent rename.",
    "regexForNewIds": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)+$",

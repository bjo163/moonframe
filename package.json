{
  "name": "@moonframe/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "files": [
    "src/"
  ],
  "description": "React components and fifteen distinct light/dark skins for Moonframe",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "import": "./src/index.js", "default": "./src/index.js" },
    "./styles.css": "./src/styles.css",
    "./tailwind.css": "./src/tailwind.css",
    "./skins": { "types": "./src/skins.d.ts", "import": "./src/skins.js", "default": "./src/skins.js" },
    "./theme": { "types": "./src/theme.d.ts", "import": "./src/theme.js", "default": "./src/theme.js" }
  },
  "sideEffects": ["**/*.css"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "pnpm --filter moonframe dev",
    "build": "pnpm --filter moonframe build",
    "start": "pnpm --filter moonframe start",
    "test": "node --test tests/runtime.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-contracts.mjs",
    "tokens": "node scripts/generate-tokens.mjs",
    "pack:local": "pnpm pack",
    "check": "pnpm run validate && pnpm test && pnpm run typecheck && pnpm run build"
  },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "devDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@playwright/test": "1.64.1"
  }
}
